  <!-- is to indicate to Gradle or any Gradle module metadata file consumer  -->
  <!-- that they should prefer consuming it instead. -->
  <!-- do_not_remove: published-with-gradle-metadata -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.fleeksoft.ksoup</groupId>
  <artifactId>ksoup-jvm</artifactId>
  <version>0.2.6</version>
  <name>ksoup</name>
  <description>Ksoup is a Kotlin Multiplatform library for working with HTML and XML, and offers an easy-to-use API for URL fetching, data parsing, extraction, and manipulation using DOM and CSS selectors.</description>
  <url>https://github.com/fleeksoft/ksoup</url>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/MIT</url>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Sabeeh Ul Hussnain Anjum</name>
      <email>fleeksoft@gmail.com</email>
      <organization>Fleek Soft</organization>
    </developer>
  </developers>
  <scm>
    <connection>https://github.com/fleeksoft/ksoup.git</connection>
    <url>https://github.com/fleeksoft/ksoup</url>
  </scm>
  <issueManagement>
    <system>Github</system>
    <url>https://github.com/fleeksoft/ksoup/issues</url>
  </issueManagement>
  <dependencies>
    <dependency>
      <groupId>com.fleeksoft.io</groupId>
      <artifactId>io-core-jvm</artifactId>
      <version>0.0.8</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.fleeksoft.charset</groupId>
      <artifactId>charset-jvm</artifactId>
      <version>0.0.8</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>org.jetbrains.kotlin</groupId>
      <artifactId>kotlin-stdlib</artifactId>
      <version>2.3.10</version>
      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>co.touchlab</groupId>
      <artifactId>stately-concurrency-jvm</artifactId>
      <version>2.1.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>
</project>
